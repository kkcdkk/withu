{
  "sourceLanguage": "ko",
  "strings": {
    "NSFocusStatusUsageDescription": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면/집중 모드를 감지해 캐릭터 상태(예: 자는 모습)에 반영해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to detect Sleep Focus so your character sleeps when you do."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걷기/뛰기/자전거 활동을 실시간 감지해 캐릭터에 반영해요. 모션 데이터는 기기 안에만 머무르고 외부로 전송하지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to detect walks, runs, and rides so your character can match your activity."
          }
        }
      }
    }
  },
  "version": "1.0"
}