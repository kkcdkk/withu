<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 날씨 — Open-Meteo 좌표(반올림 2자리)라 coarse 로 충분 (SCOPE) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 알림 (API 33+) — 배치 완료/취침 리마인더 등 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 폰 모션 활동 분류 (phoneWorkoutState) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 배치 생성 백그라운드 실행 (WorkManager setForeground dataSync) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 사진 저장 — API 28 만 WRITE 필요 (PhotoSaver.needsLegacyWritePermission) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 카메라 합성 (스펙 12 Part A) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Health Connect 읽기 6종 (스펙 10 §3.2 대응) -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!-- Health Connect 앱 가시성 (getSdkStatus / 권한 연동) -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".WithuApp"
        android:label="Withy"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect 권한 근거(rationale) — API 33 이하 진입점 -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect 권한 근거 — Android 14+ (권한 사용 화면) -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- 홈 위젯 (Glance) receiver — 알림 딥링크는 MainActivity 가 소비 -->
        <receiver
            android:name=".widget.CharacterWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/character_widget_info" />
        </receiver>

        <!-- 배치 생성 Worker 의 FGS(dataSync) — WorkManager 기본 서비스에 타입 병합 -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
